---
import "@fontsource-variable/newsreader";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "@fontsource/ibm-plex-mono/600.css";
import "../styles/global.css";
import { cfg, REPO } from "../lib/source";

interface Props {
  title: string;
  description: string;
  active?: "home" | "guide";
}
const { title, description, active = "home" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${cfg.site}${cfg.base}/og.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      // Apply a saved theme before first paint. No saved choice: follow the OS.
      try {
        const t = localStorage.getItem("site-theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch {}
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="brand" href={`${base}/`} aria-label={`${cfg.name} home`}>
          <svg class="brand__mark" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
            <g fill="currentColor"><rect x="5" y="5" width="4" height="4" rx="1" opacity=".85" /><rect x="10" y="5" width="4" height="4" rx="1" opacity=".85" /><rect x="15" y="5" width="4" height="4" rx="1" opacity=".85" /><rect x="5" y="10" width="4" height="4" rx="1" opacity=".65" /><rect x="10" y="10" width="4" height="4" rx="1" opacity=".65" /><rect x="5" y="15" width="4" height="4" rx="1" opacity=".45" /><rect x="10" y="15" width="4" height="4" rx="1" opacity=".45" /><rect x="15" y="15" width="4" height="4" rx="1" opacity=".45" /></g>
            <rect x="15" y="10" width="4" height="4" rx="1" fill="var(--data)" />
          </svg>
          <span>{cfg.name}</span>
        </a>
        <nav aria-label="Primary" class="site-nav">
          <a class="nav-home" href={`${base}/`} aria-current={active === "home" ? "page" : undefined}>overview</a>
          <a href={`${base}/guide/`} aria-current={active === "guide" ? "page" : undefined}>guide</a>
          <a href={REPO} rel="noopener">source</a>
          <button class="theme-toggle" type="button" aria-label="Switch colour theme" data-theme-toggle>
            <svg class="i-sun" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
            <svg class="i-moon" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
          </button>
        </nav>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer__inner">
        <p>{cfg.footnote || cfg.tagline}</p>
        <p class="site-footer__links">
          <a href={`${base}/guide/`}>guide</a>
          <a href={REPO}>source</a>
          <a href={`${cfg.site}${cfg.base}/`}>termwise</a>
        </p>
      </div>
    </footer>

    <script>
      const root = document.documentElement;
      document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
        const dark = root.dataset.theme
          ? root.dataset.theme === "dark"
          : matchMedia("(prefers-color-scheme: dark)").matches;
        const next = dark ? "light" : "dark";
        root.dataset.theme = next;
        try { localStorage.setItem("site-theme", next); } catch {}
      });
    </script>
  </body>
</html>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
    background: var(--background);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    max-width: var(--wide);
    margin: 0 auto;
    padding: 0.85rem var(--gutter);
  }
  .brand {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    color: var(--foreground);
    font-size: 1.15rem;
    font-weight: 560;
    letter-spacing: -0.02em;
    text-decoration: none;
  }
  .brand:hover { color: var(--foreground); }
  .brand__mark { align-self: center; color: var(--data); }
  .site-nav { display: flex; align-items: center; gap: 1.1rem; }
  .site-nav a {
    padding: 0.55rem 0;
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.01em;
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }
  .site-nav a:hover { color: var(--foreground); border-bottom-color: var(--foreground); }
  .site-nav a[aria-current="page"] { color: var(--foreground); border-bottom-color: var(--data); }
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    margin-left: 0.2rem;
    border: 1px solid var(--border);
    border-radius: 2px;
    background: transparent;
    color: var(--foreground);
    cursor: pointer;
  }
  .theme-toggle:hover { border-color: var(--foreground); }
  .i-moon { display: none; }
  :global(html:not(.js)) .theme-toggle { display: none; }
  :global(:root[data-theme="dark"]) .i-sun { display: none; }
  :global(:root[data-theme="dark"]) .i-moon { display: block; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .i-sun { display: none; }
    :global(:root:not([data-theme="light"])) .i-moon { display: block; }
  }
  main:focus { outline: none; }
  .site-footer {
    border-top: 1px solid var(--border);
    margin-top: 6rem;
    padding: 1.75rem var(--gutter) 2.5rem;
    color: var(--muted-foreground);
    font-size: 0.9rem;
  }
  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem 2rem;
    max-width: var(--wide);
    margin: 0 auto;
  }
  .site-footer__inner p { max-width: 52ch; }
  .site-footer__links {
    display: flex;
    gap: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
  }
  .site-footer__links a { color: var(--muted-foreground); text-decoration: none; }
  .site-footer__links a:hover { color: var(--foreground); text-decoration: underline; }

  @media (max-width: 460px) {
    .site-nav .nav-home { display: none; }
    .site-nav { gap: 0.85rem; }
  }
</style>
