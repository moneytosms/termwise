---
// Bare shell for the bespoke landing page: head, meta, skip link, <main>. No
// header, footer, fonts or global CSS: the page brings its own identity.
// Add <style is:global> and font imports in the page itself.
interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
import cfg from "../../site.config.mjs";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = `${cfg.site}${cfg.base}/og.png`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      // Same saved key as Base.astro. No saved choice: follow the OS.
      try {
        const t = localStorage.getItem("site-theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch {}
    </script>
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <script>
      const root = document.documentElement;
      document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
        const dark = root.dataset.theme
          ? root.dataset.theme === "dark"
          : matchMedia("(prefers-color-scheme: dark)").matches;
        const next = dark ? "light" : "dark";
        root.dataset.theme = next;
        try { localStorage.setItem("site-theme", next); } catch {}
      });
    </script>
  </body>
</html>

<style>
  .skip-link { position: absolute; left: -999px; }
  .skip-link:focus { left: 0.5rem; top: 0.5rem; z-index: 1000; background: #fff; color: #000; padding: 0.5rem 0.75rem; }
  main:focus { outline: none; }
</style>
